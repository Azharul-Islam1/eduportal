generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  ADMIN
  TEACHER
  STAFF
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

enum FeeType {
  TUITION
  EXAM
  LIBRARY
  TRANSPORT
  HOSTEL
  OTHER
}

enum BookStatus {
  ISSUED
  RETURNED
  OVERDUE
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum ExamStatus {
  DRAFT
  ACTIVE
  PUBLISHED
}

enum ExamType {
  MIDTERM
  FINAL
  QUIZ
  ASSIGNMENT
  PRACTICAL
}

// ─── System-level ─────────────────────────────────────────────────────────────

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  maxStudents  Int      @default(100)
  maxTeachers  Int      @default(20)
  features     Json     @default("[]")
  priceMonthly Float    @default(0)
  priceYearly  Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schools School[]
}

model School {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  domain             String?            @unique
  address            String?            @db.Text
  phone              String?
  email              String?
  principalName      String?
  status             SchoolStatus       @default(TRIAL)
  dbName             String?
  verifyToken        String?
  isVerified         Boolean            @default(false)
  planId             String?
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  studentCount       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  plan  Plan?  @relation(fields: [planId], references: [id])
  users         User[]
  guardians     Guardian[]
  academicYears AcademicYear[]
  classLevels   ClassLevel[]
  exams         Exam[]
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorType  String
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}

model AppLog {
  id        String   @id @default(cuid())
  level     String   @default("info")
  message   String   @db.Text
  path      String?
  method    String?
  status    Int?
  duration  Int?
  userId    String?
  schoolId  String?
  requestId String?
  stack     String?  @db.LongText
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@index([path])
}

// ─── School-level ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  phone     String?
  address   String?
  avatar    String?
  isActive  Boolean  @default(true)
  schoolId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School?  @relation(fields: [schoolId], references: [id])
  student Student?
  teacher Teacher?
  parent  Parent?
  notices Notice[]
}

model Student {
  id            String    @id @default(cuid())
  userId        String    @unique
  studentId     String    @unique
  classId       String
  rollNumber    String?
  admissionDate DateTime  @default(now())
  dateOfBirth    DateTime?
  gender         String?
  bloodGroup     String?
  photo          String?
  previousSchool String?
  previousGrade  String?
  tcNumber       String?
  religion       String?
  nationality    String?
  parentId       String?

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class                  @relation(fields: [classId], references: [id])
  parent      Parent?                @relation(fields: [parentId], references: [id])
  attendance  Attendance[]
  results     ExamResult[]
  marks       Mark[]
  feePayments FeePayment[]
  bookIssues  BookIssue[]
  submissions AssignmentSubmission[]
  guardians   StudentGuardian[]
  documents   Document[]
  enrollments Enrollment[]
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id            String    @id @default(cuid())
  userId        String    @unique
  employeeId    String    @unique
  department    String?
  qualification String?
  joiningDate   DateTime  @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects    Subject[]
  timetables  Timetable[]
  exams       Exam[]
  assignments Assignment[]
  attendances Attendance[]
  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Parent {
  id     String @id @default(cuid())
  userId String @unique

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  children Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id           String  @id @default(cuid())
  name         String
  section      String  @default("A")
  capacity     Int     @default(40)
  academicYear String  @default("2025-2026")
  classLevelId String?

  classLevel         ClassLevel?         @relation(fields: [classLevelId], references: [id])
  students           Student[]
  timetables         Timetable[]
  exams              Exam[]
  assignments        Assignment[]
  feeStructures      FeeStructure[]
  enrollments        Enrollment[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  invoices           Invoice[]
  examPapers         ExamPaper[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, section, academicYear])
}

model Subject {
  id         String  @id @default(cuid())
  name       String
  code       String  @unique
  teacherId  String?
  type       String  @default("THEORY")
  isElective Boolean @default(false)

  teacher            Teacher?            @relation(fields: [teacherId], references: [id])
  timetables         Timetable[]
  exams              Exam[]
  assignments        Assignment[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  examPapers         ExamPaper[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Timetable {
  id        String  @id @default(cuid())
  classId   String
  subjectId String
  teacherId String
  day       String
  period    Int     @default(1)
  startTime String?
  endTime   String?

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, day, period])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  teacherId String?
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  period    Int              @default(0)
  markedBy  String?
  remarks   String?

  student Student          @relation(fields: [studentId], references: [id])
  teacher Teacher?         @relation(fields: [teacherId], references: [id])
  audits  AttendanceAudit[]

  createdAt DateTime @default(now())

  @@unique([studentId, date, period])
}

model AttendanceAudit {
  id           String           @id @default(cuid())
  attendanceId String
  oldStatus    AttendanceStatus
  newStatus    AttendanceStatus
  reason       String
  changedBy    String
  changedAt    DateTime         @default(now())

  attendance Attendance @relation(fields: [attendanceId], references: [id])

  @@index([attendanceId])
}

model Exam {
  id           String     @id @default(cuid())
  name         String
  academicYear String     @default("2025-2026")
  startDate    DateTime?
  endDate      DateTime?
  weightage    Float      @default(100)
  status       ExamStatus @default(DRAFT)
  publishedAt  DateTime?
  schoolId     String?

  // legacy per-subject fields (kept for backward compat)
  type         ExamType  @default(MIDTERM)
  classId      String?
  subjectId    String?
  teacherId    String?
  date         DateTime?
  totalMarks   Int       @default(100)
  passingMarks Int       @default(40)
  weight       Float     @default(1.0)
  isPublished  Boolean   @default(false)

  school  School?      @relation(fields: [schoolId], references: [id])
  class   Class?       @relation(fields: [classId], references: [id])
  subject Subject?     @relation(fields: [subjectId], references: [id])
  teacher Teacher?     @relation(fields: [teacherId], references: [id])
  results ExamResult[]
  papers  ExamPaper[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model ExamPaper {
  id           String @id @default(cuid())
  examId       String
  subjectId    String
  classId      String
  maxMarks     Float  @default(100)
  passingMarks Float  @default(40)

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id], map: "ExamPaper_classId_fkey")
  marks   Mark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, subjectId, classId])
  @@index([examId])
  @@index([classId])
}

model Mark {
  id            String  @id @default(cuid())
  paperId       String
  studentId     String
  marksObtained Float?
  isAbsent      Boolean @default(false)
  isDraft       Boolean @default(true)

  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paperId, studentId])
  @@index([paperId])
  @@index([studentId])
}

model ExamResult {
  id            String  @id @default(cuid())
  examId        String
  studentId     String
  marksObtained Float
  grade         String?
  remarks       String?

  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  subjectId   String
  teacherId   String
  classId     String
  dueDate     DateTime

  subject     Subject                @relation(fields: [subjectId], references: [id])
  teacher     Teacher                @relation(fields: [teacherId], references: [id])
  class       Class                  @relation(fields: [classId], references: [id])
  submissions AssignmentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime  @default(now())
  grade        Float?
  feedback     String?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
}

model FeeStructure {
  id           String    @id @default(cuid())
  name         String?
  schoolId     String?
  classId      String?
  feeType      FeeType   @default(TUITION)
  amount       Float
  academicYear String    @default("2025-2026")
  dueDate      DateTime?
  description  String?
  frequency    String    @default("ANNUAL")

  class    Class?       @relation(fields: [classId], references: [id])
  payments FeePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model FeePayment {
  id             String    @id @default(cuid())
  studentId      String
  feeStructureId String
  paidAmount     Float
  paidDate       DateTime  @default(now())
  status         FeeStatus @default(PENDING)
  paymentMethod  String?
  transactionId  String?
  receiptNumber  String?
  remarks        String?

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guardian {
  id         String  @id @default(cuid())
  name       String
  relation   String  @default("GUARDIAN")
  phone      String
  email      String?
  occupation String?
  address    String? @db.Text
  schoolId   String

  school       School            @relation(fields: [schoolId], references: [id])
  studentLinks StudentGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model StudentGuardian {
  id         String  @id @default(cuid())
  studentId  String
  guardianId String
  isPrimary  Boolean @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
}

model Enrollment {
  id           String  @id @default(cuid())
  studentId    String
  classId      String
  academicYear String  @default("2025-2026")
  rollNumber   String?
  status       String  @default("ACTIVE")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYear])
}

model Document {
  id        String  @id @default(cuid())
  studentId String
  type      String  @default("OTHER")
  name      String
  url       String
  size      Int?
  mimeType  String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model BookCategory {
  id   String @id @default(cuid())
  name String @unique

  books Book[]
}

model Book {
  id          String  @id @default(cuid())
  title       String
  author      String
  isbn        String  @unique
  categoryId  String
  quantity    Int     @default(1)
  available   Int     @default(1)
  publishYear Int?
  publisher   String?
  location    String?

  category BookCategory @relation(fields: [categoryId], references: [id])
  issues   BookIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookIssue {
  id         String     @id @default(cuid())
  bookId     String
  studentId  String
  issueDate  DateTime   @default(now())
  dueDate    DateTime
  returnDate DateTime?
  fine       Float?     @default(0)
  status     BookStatus @default(ISSUED)

  book    Book    @relation(fields: [bookId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  targetRole  String?
  publishedBy String
  expiryDate  DateTime?
  isActive    Boolean   @default(true)

  author User @relation(fields: [publishedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  date        DateTime
  endDate     DateTime?
  venue       String?
  organizer   String?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  schoolId  String

  school School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, schoolId])
}

model ClassLevel {
  id          String  @id @default(cuid())
  name        String
  order       Int     @default(0)
  description String?
  schoolId    String

  school   School  @relation(fields: [schoolId], references: [id])
  sections Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, schoolId])
}

model ClassSubject {
  id        String @id @default(cuid())
  classId   String
  subjectId String

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
}

model TeacherAssignment {
  id           String @id @default(cuid())
  teacherId    String
  classId      String
  subjectId    String
  academicYear String @default("2025-2026")

  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  @@unique([classId, subjectId, academicYear])
}

model Invoice {
  id           String        @id @default(cuid())
  invoiceNo    String        @unique
  studentId    String
  classId      String
  items        Json
  totalAmount  Float
  paidAmount   Float         @default(0)
  dueDate      DateTime
  academicYear String        @default("2025-2026")
  period       String
  status       FeeStatus     @default(PENDING)
  schoolId     String

  student  Student   @relation(fields: [studentId], references: [id])
  class    Class     @relation(fields: [classId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, period, academicYear])
  @@index([schoolId])
  @@index([status])
}

model Payment {
  id            String      @id @default(cuid())
  invoiceId     String
  receiptNumber String      @unique
  amount        Float
  paymentMode   PaymentMode @default(CASH)
  reference     String?
  paymentDate   DateTime    @default(now())
  remarks       String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
